RESEND_API_KEY=
RESEND_FROM="Andy <andy@embodyvc.com>"
# Optional: only for `npm run send:test`. The GUI asks for recipients in the browser.
RESEND_TO="kamtocheung1104@gmail.com"
# Optional: GUI server port (default 3847)
# PORT=3847
# Optional: if set, the GUI "Send password" must match (use on Vercel so the site is not an open relay)
# GUI_SEND_SECRET=

# Inbound receiving / forwarding (Resend → webhook → forward)
# Create a webhook in Resend for event `email.received` and paste its signing secret here.
# RESEND_WEBHOOK_SECRET=whsec_...
# Where to forward *received* emails to:
# FORWARD_TO="kamtocheung1104@gmail.com"
# Optional: force forwarding sender (must be a verified sender in Resend). Defaults to RESEND_FROM.
# FORWARD_FROM="Andy <andy@embodyvc.com>"
# Optional: only forward inbound emails originally addressed to this exact address.
# FORWARD_ONLY_TO="andy@embodyvc.com"
# Optional: subject prefix added to forwarded emails
# FORWARD_SUBJECT_PREFIX="[FWD] "
